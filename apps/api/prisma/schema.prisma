// Configuración de Prisma para SIGBA (ADR-05, ADR-07)
// Multi-schema: core, plataforma, inventario, beneficiarios, analitica

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "plataforma", "inventario", "beneficiarios", "analitica"]
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// Schema: plataforma
// ==========================================

model Red {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String   @db.VarChar(200)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  bancos Banco[]

  @@map("red")
  @@schema("plataforma")
}

model Banco {
  id            String   @id @default(uuid()) @db.Uuid
  redId         String   @map("red_id") @db.Uuid
  nombre        String   @db.VarChar(200)
  codigo        String   @unique @db.VarChar(20)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  red           Red              @relation(fields: [redId], references: [id])
  bodegas       Bodega[]
  parametros    ParametroBanco[]
  usuariosRoles UsuarioRol[]

  @@map("banco")
  @@schema("plataforma")
}

model Bodega {
  id            String   @id @default(uuid()) @db.Uuid
  bancoId       String   @map("banco_id") @db.Uuid
  nombre        String   @db.VarChar(200)
  direccion     String?  @db.VarChar(500)
  activa        Boolean  @default(true)
  creadoPor     String?  @map("creado_por") @db.VarChar(100)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  banco Banco @relation(fields: [bancoId], references: [id])

  @@map("bodega")
  @@schema("plataforma")
}

model Usuario {
  id            String   @id @default(uuid()) @db.Uuid
  emisor        String   @db.VarChar(500)
  auth0Sub      String   @map("auth0_sub") @db.VarChar(200)
  email         String   @unique @db.VarChar(200)
  nombre        String   @db.VarChar(200)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  roles UsuarioRol[]

  @@unique([emisor, auth0Sub])
  @@map("usuario")
  @@schema("plataforma")
}

model Rol {
  id            String   @id @default(uuid()) @db.Uuid
  codigo        String   @unique @db.VarChar(50)
  nombre        String   @db.VarChar(100)
  descripcion   String?  @db.VarChar(500)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  usuarios UsuarioRol[]

  @@map("rol")
  @@schema("plataforma")
}

/// El alcance depende del rol: super_admin sin banco, institucion con banco e
/// institución, el resto con banco y sin institución. Lo exige el trigger
/// usuario_rol_alcance, y el UNIQUE es NULLS NOT DISTINCT (SBA-18); Prisma no
/// expresa ninguno de los dos.
model UsuarioRol {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  rolId         String   @map("rol_id") @db.Uuid
  bancoId       String?  @map("banco_id") @db.Uuid
  /// Sin FK (ADR-05): la institución es de beneficiarios. Que exista y sea del
  /// banco de la asignación lo tendrá que validar el servicio que asigne roles,
  /// que todavía no existe.
  institucionId String?  @map("institucion_id") @db.Uuid
  activo        Boolean  @default(true)
  creadoPor     String?  @map("creado_por") @db.VarChar(100)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])
  banco   Banco?  @relation(fields: [bancoId], references: [id])

  @@unique([usuarioId, rolId, bancoId, institucionId])
  @@map("usuario_rol")
  @@schema("plataforma")
}

model ParametroBanco {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId     String    @map("banco_id") @db.Uuid
  clave       String    @db.Text
  valor       Json      @db.JsonB
  version     Int
  fechaInicio DateTime  @map("fecha_inicio") @db.Date
  fechaFin    DateTime? @map("fecha_fin") @db.Date
  creadoPor   String?   @map("creado_por") @db.VarChar(100)
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  banco Banco @relation(fields: [bancoId], references: [id])

  @@unique([bancoId, clave, version])
  @@index([bancoId, clave, fechaInicio])
  @@map("parametro_banco")
  @@schema("plataforma")
}

// ==========================================
// Schema: inventario
// ==========================================

// Las FK dentro del banco son compuestas (banco_id, id). Una FK simple la
// comprueba Postgres sin RLS, así que dejaría colgar un producto del banco A
// de una categoría del banco B.

/// Un código del Banco (C801, G103), que agrupa productos en cualquier
/// presentación. La línea (Cereales, Grasas) agrupa códigos en pantalla.
model Categoria {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String   @map("banco_id") @db.Uuid
  /// Sin código, los productos de la categoría quedan pendientes de código.
  codigo         String?  @db.VarChar(20)
  nombre         String   @db.VarChar(100)
  linea          String?  @db.VarChar(100)
  /// Los productos que el Banco lista bajo el código, para orientar al operario.
  descripcion    String?  @db.Text
  activa         Boolean  @default(true)
  creadoPor      String?  @map("creado_por") @db.VarChar(100)
  actualizadoPor String?  @map("actualizado_por") @db.VarChar(100)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  productos Producto[]

  @@unique([bancoId, id])
  // El nombre se repite en la hoja del Banco (cuatro «Otros alimentos»); el
  // código no.
  @@unique([bancoId, codigo])
  @@map("categoria")
  @@schema("inventario")
}

model Producto {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String   @map("banco_id") @db.Uuid
  categoriaId    String   @map("categoria_id") @db.Uuid
  nombre         String   @db.VarChar(200)
  activo         Boolean  @default(true)
  creadoPor      String?  @map("creado_por") @db.VarChar(100)
  actualizadoPor String?  @map("actualizado_por") @db.VarChar(100)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  categoria   Categoria    @relation(fields: [bancoId, categoriaId], references: [bancoId, id])
  referencias Referencia[]

  @@unique([bancoId, id])
  @@unique([bancoId, nombre])
  @@map("producto")
  @@schema("inventario")
}

/// Producto más presentación, sin marca ni SKU: arroz Diana 500 g y arroz D1
/// 500 g son la misma referencia (Arquitectura, glosario). El código del Banco
/// lo hereda de la categoría de su producto.
model Referencia {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId            String   @map("banco_id") @db.Uuid
  productoId         String   @map("producto_id") @db.Uuid
  presentacion       String   @db.VarChar(100)
  equivalenciaKg     Decimal  @map("equivalencia_kg") @db.Decimal(10, 3)
  creadaDesdeCelular Boolean  @default(false) @map("creada_desde_celular")
  activa             Boolean  @default(true)
  creadoPor          String?  @map("creado_por") @db.VarChar(100)
  actualizadoPor     String?  @map("actualizado_por") @db.VarChar(100)
  creadoEn           DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn      DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  producto Producto @relation(fields: [bancoId, productoId], references: [bancoId, id])

  @@unique([bancoId, productoId, presentacion])
  @@map("referencia")
  @@schema("inventario")
}

enum TipoDonante {
  empresa
  parroquia
  particular
  otro_banco

  @@map("tipo_donante")
  @@schema("inventario")
}

model Donante {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String      @map("banco_id") @db.Uuid
  nombre         String      @db.VarChar(200)
  tipo           TipoDonante
  contacto       String?     @db.VarChar(200)
  activo         Boolean     @default(true)
  creadoPor      String?     @map("creado_por") @db.VarChar(100)
  actualizadoPor String?     @map("actualizado_por") @db.VarChar(100)
  creadoEn       DateTime    @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime    @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  @@index([bancoId, tipo])
  @@map("donante")
  @@schema("inventario")
}

enum TipoInstitucion {
  parroquia
  comunidad_religiosa
  fundacion

  @@map("tipo_institucion")
  @@schema("beneficiarios")
}

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
  domingo

  @@map("dia_semana")
  @@schema("beneficiarios")
}

/// Catálogo por banco que administra coordinación. El índice único sobre
/// lower(nombre) va a mano en la migración (Prisma no expresa expresiones).
model TipoPoblacion {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId String  @map("banco_id") @db.Uuid
  nombre  String  @db.VarChar(100)
  activo  Boolean @default(true)

  instituciones Institucion[]

  @@unique([bancoId, id])
  @@map("tipo_poblacion")
  @@schema("beneficiarios")
}

/// Directorio de instituciones (SBA-26). El UNIQUE sobre lower(nombre) y el
/// CHECK de actualizado_por/actualizado_en van a mano en la migración.
model Institucion {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId          String          @map("banco_id") @db.Uuid
  nombre           String          @db.VarChar(200)
  tipo             TipoInstitucion
  contactoNombre   String          @map("contacto_nombre") @db.VarChar(200)
  contactoTelefono String?         @map("contacto_telefono") @db.VarChar(30)
  contactoCorreo   String?         @map("contacto_correo") @db.VarChar(200)
  direccion        String?         @db.VarChar(500)
  diaRecogida      DiaSemana?      @map("dia_recogida")
  tipoPoblacionId  String          @map("tipo_poblacion_id") @db.Uuid
  activa           Boolean         @default(true)
  actualizadoPor   String?         @map("actualizado_por") @db.VarChar(100)
  actualizadoEn    DateTime?       @map("actualizado_en") @db.Timestamptz

  tipoPoblacion TipoPoblacion @relation(fields: [bancoId, tipoPoblacionId], references: [bancoId, id])

  @@unique([bancoId, id])
  @@index([bancoId, activa])
  @@map("institucion")
  @@schema("beneficiarios")
}

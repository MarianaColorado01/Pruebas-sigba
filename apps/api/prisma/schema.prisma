// Configuración de Prisma para SIGBA (ADR-05, ADR-07)
// Multi-schema: core, plataforma, inventario, beneficiarios, analitica

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "plataforma", "inventario", "beneficiarios", "analitica"]
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// Schema: plataforma
// ==========================================

model Red {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String   @db.VarChar(200)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  bancos Banco[]

  @@map("red")
  @@schema("plataforma")
}

model Banco {
  id            String   @id @default(uuid()) @db.Uuid
  redId         String   @map("red_id") @db.Uuid
  nombre        String   @db.VarChar(200)
  codigo        String   @unique @db.VarChar(20)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  red           Red              @relation(fields: [redId], references: [id])
  bodegas       Bodega[]
  parametros    ParametroBanco[]
  usuariosRoles UsuarioRol[]
  invitaciones  Invitacion[]

  @@map("banco")
  @@schema("plataforma")
}

model Bodega {
  id            String   @id @default(uuid()) @db.Uuid
  bancoId       String   @map("banco_id") @db.Uuid
  /// Único por banco sin importar mayúsculas: índice sobre lower(nombre) en la migración.
  nombre        String   @db.VarChar(80)
  direccion     String?  @db.VarChar(200)
  activa        Boolean  @default(true)
  creadoPor     String?  @map("creado_por") @db.VarChar(100)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  banco Banco @relation(fields: [bancoId], references: [id])

  @@map("bodega")
  @@schema("plataforma")
}

model Usuario {
  id            String   @id @default(uuid()) @db.Uuid
  emisor        String   @db.VarChar(500)
  auth0Sub      String   @map("auth0_sub") @db.VarChar(200)
  email         String   @unique @db.VarChar(200)
  nombre        String   @db.VarChar(200)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  roles                 UsuarioRol[]
  invitacionesAceptadas Invitacion[] @relation("InvitacionAceptadaPor")
  invitacionesCreadas   Invitacion[] @relation("InvitacionCreadaPor")

  @@unique([emisor, auth0Sub])
  @@map("usuario")
  @@schema("plataforma")
}

model Rol {
  id            String   @id @default(uuid()) @db.Uuid
  codigo        String   @unique @db.VarChar(50)
  nombre        String   @db.VarChar(100)
  descripcion   String?  @db.VarChar(500)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  usuarios     UsuarioRol[]
  invitaciones Invitacion[]

  @@map("rol")
  @@schema("plataforma")
}

/// El alcance depende del rol: super_admin sin banco, institucion con banco e
/// institución, el resto con banco y sin institución. Lo exige el trigger
/// usuario_rol_alcance, y el UNIQUE es NULLS NOT DISTINCT (SBA-18); Prisma no
/// expresa ninguno de los dos.
model UsuarioRol {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  rolId         String   @map("rol_id") @db.Uuid
  bancoId       String?  @map("banco_id") @db.Uuid
  /// Sin FK (ADR-05): la institución es de beneficiarios. Que exista y sea del
  /// banco de la asignación lo tendrá que validar el servicio que asigne roles,
  /// que todavía no existe.
  institucionId String?  @map("institucion_id") @db.Uuid
  activo        Boolean  @default(true)
  creadoPor     String?  @map("creado_por") @db.VarChar(100)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])
  banco   Banco?  @relation(fields: [bancoId], references: [id])

  @@unique([usuarioId, rolId, bancoId, institucionId])
  @@map("usuario_rol")
  @@schema("plataforma")
}

/// Invitación a un banco con un rol (SBA-19, D4 y D5). Solo guarda el SHA-256
/// del token. La acepta plataforma.aceptar_invitacion, que es SECURITY DEFINER.
model Invitacion {
  id            String    @id @default(uuid()) @db.Uuid
  bancoId       String    @map("banco_id") @db.Uuid
  email         String    @db.VarChar(200)
  nombre        String    @db.VarChar(200)
  rolId         String    @map("rol_id") @db.Uuid
  /// Sin FK (ADR-05), como en usuario_rol.
  institucionId String?   @map("institucion_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  venceEn       DateTime  @map("vence_en") @db.Timestamptz
  aceptadaEn    DateTime? @map("aceptada_en") @db.Timestamptz
  aceptadaPorId String?   @map("aceptada_por") @db.Uuid
  revocadaEn    DateTime? @map("revocada_en") @db.Timestamptz
  creadoPorId   String    @map("creado_por") @db.Uuid
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  banco       Banco    @relation(fields: [bancoId], references: [id])
  rol         Rol      @relation(fields: [rolId], references: [id])
  aceptadaPor Usuario? @relation("InvitacionAceptadaPor", fields: [aceptadaPorId], references: [id], onDelete: Restrict)
  creadoPor   Usuario  @relation("InvitacionCreadaPor", fields: [creadoPorId], references: [id])

  @@index([bancoId, creadoEn])
  @@map("invitacion")
  @@schema("plataforma")
}

model ParametroBanco {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId     String    @map("banco_id") @db.Uuid
  clave       String    @db.Text
  valor       Json      @db.JsonB
  version     Int
  fechaInicio DateTime  @map("fecha_inicio") @db.Date
  fechaFin    DateTime? @map("fecha_fin") @db.Date
  creadoPor   String?   @map("creado_por") @db.VarChar(100)
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  banco Banco @relation(fields: [bancoId], references: [id])

  @@unique([bancoId, clave, version])
  @@index([bancoId, clave, fechaInicio])
  @@map("parametro_banco")
  @@schema("plataforma")
}

// ==========================================
// Schema: inventario
// ==========================================

// Las FK dentro del banco son compuestas (banco_id, id). Una FK simple la
// comprueba Postgres sin RLS, así que dejaría colgar un producto del banco A
// de una categoría del banco B.

/// Un código del Banco (C801, G103), que agrupa productos en cualquier
/// presentación. La línea (Cereales, Grasas) agrupa códigos en pantalla.
model Categoria {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String   @map("banco_id") @db.Uuid
  /// Sin código, los productos de la categoría quedan pendientes de código.
  codigo         String?  @db.VarChar(20)
  nombre         String   @db.VarChar(100)
  linea          String?  @db.VarChar(100)
  /// Los productos que el Banco lista bajo el código, para orientar al operario.
  descripcion    String?  @db.Text
  activa         Boolean  @default(true)
  creadoPor      String?  @map("creado_por") @db.VarChar(100)
  actualizadoPor String?  @map("actualizado_por") @db.VarChar(100)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  productos Producto[]

  @@unique([bancoId, id])
  // El nombre se repite en la hoja del Banco (cuatro «Otros alimentos»); el
  // código no.
  @@unique([bancoId, codigo])
  @@map("categoria")
  @@schema("inventario")
}

model Producto {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String   @map("banco_id") @db.Uuid
  categoriaId    String   @map("categoria_id") @db.Uuid
  nombre         String   @db.VarChar(200)
  activo         Boolean  @default(true)
  creadoPor      String?  @map("creado_por") @db.VarChar(100)
  actualizadoPor String?  @map("actualizado_por") @db.VarChar(100)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  categoria   Categoria    @relation(fields: [bancoId, categoriaId], references: [bancoId, id])
  referencias Referencia[]

  @@unique([bancoId, id])
  // El UNIQUE (banco_id, inventario.normalizar(nombre)) vive en la migración
  // 20261013120000: Prisma no expresa índices sobre expresiones (SBA-22).
  @@map("producto")
  @@schema("inventario")
}

/// Producto más presentación, sin marca ni SKU: arroz Diana 500 g y arroz D1
/// 500 g son la misma referencia (Arquitectura, glosario). El código del Banco
/// lo hereda de la categoría de su producto.
model Referencia {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId            String   @map("banco_id") @db.Uuid
  productoId         String   @map("producto_id") @db.Uuid
  presentacion       String   @db.VarChar(100)
  equivalenciaKg     Decimal  @map("equivalencia_kg") @db.Decimal(10, 3)
  creadaDesdeCelular Boolean  @default(false) @map("creada_desde_celular")
  activa             Boolean  @default(true)
  creadoPor          String?  @map("creado_por") @db.VarChar(100)
  actualizadoPor     String?  @map("actualizado_por") @db.VarChar(100)
  creadoEn           DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn      DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  producto Producto @relation(fields: [bancoId, productoId], references: [bancoId, id])
  lotes    Lote[]
  precios  Precio[]

  @@unique([bancoId, id])
  // El UNIQUE (banco_id, producto_id, inventario.normalizar(presentacion)) vive
  // en la migración 20261013120000: Prisma no expresa índices sobre expresiones.
  @@map("referencia")
  @@schema("inventario")
}

enum TipoDonante {
  empresa
  parroquia
  particular
  otro_banco

  @@map("tipo_donante")
  @@schema("inventario")
}

model Donante {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String      @map("banco_id") @db.Uuid
  nombre         String      @db.VarChar(200)
  tipo           TipoDonante
  contacto       String?     @db.VarChar(200)
  activo         Boolean     @default(true)
  creadoPor      String?     @map("creado_por") @db.VarChar(100)
  actualizadoPor String?     @map("actualizado_por") @db.VarChar(100)
  creadoEn       DateTime    @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime    @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  recepciones Recepcion[]

  @@unique([bancoId, id])
  @@index([bancoId, tipo])
  @@map("donante")
  @@schema("inventario")
}

enum OrigenRecepcion {
  propia
  abaco
  plataforma

  @@map("origen_recepcion")
  @@schema("inventario")
}

enum NovedadRecepcion {
  roto
  reempacado
  no_apto

  @@map("novedad_recepcion")
  @@schema("inventario")
}

/// Sin precio vigente aprobado la fila queda pendiente: nunca en cero (ADR-13).
/// Pasa a con_precio cuando se aprueba un precio que cubre su fecha (SBA-43), y
/// no vuelve.
enum EstadoValoracion {
  pendiente
  con_precio

  @@map("estado_valoracion")
  @@schema("inventario")
}

/// El signo de la cantidad lo fija el tipo: entrada suma, salida y baja
/// restan, ajuste y traslado van en los dos sentidos (SBA-35).
enum TipoMovimiento {
  entrada
  salida
  traslado
  baja
  ajuste

  @@map("tipo_movimiento")
  @@schema("inventario")
}

/// Una donación recibida (SBA-24). La idempotencia por comando la lleva
/// `core.comando_procesado` (SBA-69). Un trigger la deja sin UPDATE ni DELETE.
model Recepcion {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId   String          @map("banco_id") @db.Uuid
  donanteId String          @map("donante_id") @db.Uuid
  origen    OrigenRecepcion
  /// Sin FK: bodega vive en plataforma y SBA-34 no cruza schemas.
  bodegaId  String          @map("bodega_id") @db.Uuid
  creadoPor String          @map("creado_por") @db.VarChar(100)
  creadoEn  DateTime        @default(now()) @map("creado_en") @db.Timestamptz

  donante  Donante            @relation(fields: [bancoId, donanteId], references: [bancoId, id], onUpdate: Restrict)
  lotes    Lote[]
  detalles RecepcionDetalle[]

  @@unique([bancoId, id])
  @@map("recepcion")
  @@schema("inventario")
}

/// Lo recibido de una referencia en una recepción, con su vencimiento. El saldo
/// se lleva por banco, bodega y lote (Arquitectura 8.3). Sin UPDATE ni DELETE.
model Lote {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String    @map("banco_id") @db.Uuid
  recepcionId    String    @map("recepcion_id") @db.Uuid
  referenciaId   String    @map("referencia_id") @db.Uuid
  /// El lote impreso en el empaque, si lo trae.
  codigo         String?   @db.VarChar(50)
  /// Nulo si el producto no trae fecha, como el aseo y los no alimentos.
  vencimiento    DateTime? @db.Date
  /// Kilos por unidad al recibir, congelados: el saldo y todo movimiento del
  /// lote pesan con esta y no con la que tenga hoy la referencia (SBA-35).
  equivalenciaKg Decimal   @map("equivalencia_kg") @db.Decimal(10, 3)
  creadoPor      String    @map("creado_por") @db.VarChar(100)
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  recepcion   Recepcion    @relation(fields: [bancoId, recepcionId], references: [bancoId, id], onUpdate: Restrict)
  referencia  Referencia   @relation(fields: [bancoId, referenciaId], references: [bancoId, id], onUpdate: Restrict)
  movimientos Movimiento[]
  saldos      Saldo[]

  // Para que el movimiento no nombre una referencia distinta a la del lote.
  @@unique([bancoId, id, referenciaId])
  @@map("lote")
  @@schema("inventario")
}

/// Lo que la recepción sabe de cada fila y el libro no. Referencia, lote,
/// cantidad y kilos se leen del movimiento. Solo `valoracion` cambia, de
/// pendiente a con_precio (SBA-43).
model RecepcionDetalle {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String            @map("banco_id") @db.Uuid
  recepcionId    String            @map("recepcion_id") @db.Uuid
  /// La posición de la fila en la recepción, para devolverla en el mismo orden.
  orden          Int
  /// El movimiento de entrada que la fila escribió en el libro.
  movimientoId   String            @map("movimiento_id") @db.Uuid
  novedad        NovedadRecepcion?
  valoracion     EstadoValoracion  @default(pendiente)
  creadoPor      String            @map("creado_por") @db.VarChar(100)
  actualizadoPor String            @map("actualizado_por") @db.VarChar(100)
  creadoEn       DateTime          @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime          @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  recepcion  Recepcion  @relation(fields: [bancoId, recepcionId], references: [bancoId, id], onUpdate: Restrict)
  movimiento Movimiento @relation(fields: [bancoId, movimientoId], references: [bancoId, id], onUpdate: Restrict)

  @@unique([bancoId, movimientoId])
  @@unique([recepcionId, orden])
  @@map("recepcion_detalle")
  @@schema("inventario")
}

/// Libro append-only (ADR-08): un trigger rechaza UPDATE, DELETE y TRUNCATE,
/// y por eso no lleva actualizado_en. El id lo genera el celular, uno por
/// detalle; la llave lleva banco_id para que un id de otro banco no choque.
/// `comando_id` es el del comando que lo escribió. No sabe de recepciones: es
/// el detalle el que apunta a su movimiento, y así salidas y traslados usarán
/// el mismo libro.
model Movimiento {
  id           String         @db.Uuid
  bancoId      String         @map("banco_id") @db.Uuid
  comandoId    String         @map("comando_id") @db.Uuid
  tipo         TipoMovimiento
  referenciaId String         @map("referencia_id") @db.Uuid
  loteId       String         @map("lote_id") @db.Uuid
  bodegaId     String         @map("bodega_id") @db.Uuid
  /// Con signo: positiva suma al saldo, negativa resta.
  cantidad     Decimal        @db.Decimal(10, 3)
  kilos        Decimal        @db.Decimal(20, 6)
  creadoPor    String         @map("creado_por") @db.VarChar(100)
  creadoEn     DateTime       @default(now()) @map("creado_en") @db.Timestamptz

  lote            Lote              @relation(fields: [bancoId, loteId, referenciaId], references: [bancoId, id, referenciaId], onUpdate: Restrict)
  detalle         RecepcionDetalle?
  valoracion      Valoracion?
  baja            Baja?
  ajuste          Ajuste?
  detalleDeSalida SalidaDetalle?

  @@id([bancoId, id])
  @@index([bancoId, comandoId])
  @@map("movimiento")
  @@schema("inventario")
}

/// Lo que hay de un lote en una bodega: la suma de sus movimientos. Solo lo
/// escribe el trigger `movimiento_suma_al_saldo`; sigba_app lo lee (SBA-35).
model Saldo {
  bancoId       String   @map("banco_id") @db.Uuid
  bodegaId      String   @map("bodega_id") @db.Uuid
  loteId        String   @map("lote_id") @db.Uuid
  referenciaId  String   @map("referencia_id") @db.Uuid
  cantidad      Decimal  @db.Decimal(14, 3)
  kilos         Decimal  @db.Decimal(24, 6)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz

  lote Lote @relation(fields: [bancoId, loteId, referenciaId], references: [bancoId, id, referenciaId], onUpdate: Restrict)

  @@id([bancoId, bodegaId, loteId])
  @@index([bancoId, referenciaId])
  @@map("saldo")
  @@schema("inventario")
}

enum FuentePrecio {
  remision
  sipsa
  catalogo
  manual

  @@map("fuente_precio")
  @@schema("inventario")
}

/// «Vencido» no se guarda: es un aprobado cuyo vigente_hasta ya pasó.
enum EstadoPrecio {
  propuesto
  aprobado

  @@map("estado_precio")
  @@schema("inventario")
}

/// Precio por referencia genérica, en pesos por unidad de la presentación
/// (SBA-39, ADR-13). Un trigger solo deja aprobar un propuesto o acortar la
/// vigencia de un aprobado; sin DELETE. La exclusión que impide que dos
/// aprobados de la misma referencia crucen vigencias vive en la migración
/// 20261015130000: Prisma no expresa EXCLUDE.
model Precio {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId            String       @map("banco_id") @db.Uuid
  referenciaId       String       @map("referencia_id") @db.Uuid
  valor              Decimal      @db.Decimal(14, 2)
  piso               Decimal      @db.Decimal(14, 2)
  techo              Decimal      @db.Decimal(14, 2)
  fuente             FuentePrecio
  evidencia          String
  vigenteDesde       DateTime     @map("vigente_desde") @db.Date
  vigenteHasta       DateTime?    @map("vigente_hasta") @db.Date
  estado             EstadoPrecio @default(propuesto)
  motivoFueraDeBanda String?      @map("motivo_fuera_de_banda")
  aprobadoPor        String?      @map("aprobado_por") @db.VarChar(100)
  aprobadoEn         DateTime?    @map("aprobado_en") @db.Timestamptz
  creadoPor          String       @map("creado_por") @db.VarChar(100)
  actualizadoPor     String       @map("actualizado_por") @db.VarChar(100)
  creadoEn           DateTime     @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn      DateTime     @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  referencia   Referencia   @relation(fields: [bancoId, referenciaId], references: [bancoId, id], onUpdate: Restrict)
  valoraciones Valoracion[]

  @@unique([bancoId, id])
  @@index([bancoId, referenciaId, vigenteDesde])
  @@map("precio")
  @@schema("inventario")
}

/// Lo que vale un movimiento: una entrada que llegó sin precio, escrita cuando
/// se aprueba el precio que cubre su fecha (SBA-43), o una salida, al
/// registrarla con el precio aprobado vigente ese día (SBA-40). ADR-13. Fila
/// aparte para que el movimiento no cambie; append-only como el libro y una
/// sola por movimiento. `importe` es la cantidad en positivo × `valorUnitario`,
/// exacto.
model Valoracion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId       String   @map("banco_id") @db.Uuid
  movimientoId  String   @map("movimiento_id") @db.Uuid
  precioId      String   @map("precio_id") @db.Uuid
  valorUnitario Decimal  @map("valor_unitario") @db.Decimal(14, 2)
  importe       Decimal  @db.Decimal(24, 5)
  creadoPor     String   @map("creado_por") @db.VarChar(100)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz

  movimiento Movimiento @relation(fields: [bancoId, movimientoId], references: [bancoId, id], onUpdate: Restrict)
  precio     Precio     @relation(fields: [bancoId, precioId], references: [bancoId, id], onUpdate: Restrict)

  @@unique([bancoId, movimientoId])
  @@index([bancoId, precioId])
  @@map("valoracion")
  @@schema("inventario")
}

enum MotivoBaja {
  vencido
  no_apto
  roto
  perdida

  @@map("motivo_baja")
  @@schema("inventario")
}

/// El motivo de una baja (SBA-42). Cantidad, lote y bodega se leen de su
/// movimiento. Un trigger la deja sin UPDATE ni DELETE (ADR-08).
model Baja {
  bancoId      String     @map("banco_id") @db.Uuid
  movimientoId String     @map("movimiento_id") @db.Uuid
  motivo       MotivoBaja
  creadoPor    String     @map("creado_por") @db.VarChar(100)
  creadoEn     DateTime   @default(now()) @map("creado_en") @db.Timestamptz

  movimiento Movimiento @relation(fields: [bancoId, movimientoId], references: [bancoId, id], onUpdate: Restrict)

  @@id([bancoId, movimientoId])
  @@map("baja")
  @@schema("inventario")
}

/// El motivo de un ajuste de conteo (SBA-42), texto libre obligatorio. Un
/// trigger lo deja sin UPDATE ni DELETE (ADR-08).
model Ajuste {
  bancoId      String   @map("banco_id") @db.Uuid
  movimientoId String   @map("movimiento_id") @db.Uuid
  motivo       String   @db.VarChar(500)
  creadoPor    String   @map("creado_por") @db.VarChar(100)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz

  movimiento Movimiento @relation(fields: [bancoId, movimientoId], references: [bancoId, id], onUpdate: Restrict)

  @@id([bancoId, movimientoId])
  @@map("ajuste")
  @@schema("inventario")
}

enum TipoDespachador {
  funcionario
  voluntario

  @@map("tipo_despachador")
  @@schema("inventario")
}

/// Una entrega a una institución desde una bodega (SBA-38). Cada detalle es un
/// movimiento 'salida' del libro. Un trigger la deja sin UPDATE ni DELETE.
/// `aportePct` es el aporte solidario vigente ese día; nulo si el banco no lo
/// tenía, y el aporte queda pendiente (SBA-40).
model Salida {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId         String          @map("banco_id") @db.Uuid
  /// Sin FK: la institución vive en beneficiarios y la valida su dueño (ADR-14).
  institucionId   String          @map("institucion_id") @db.Uuid
  /// Sin FK: bodega vive en plataforma (ADR-05).
  bodegaId        String          @map("bodega_id") @db.Uuid
  despachador     String          @db.VarChar(200)
  despachadorTipo TipoDespachador @map("despachador_tipo")
  aportePct       Decimal?        @map("aporte_pct") @db.Decimal(5, 2)
  creadoPor       String          @map("creado_por") @db.VarChar(100)
  creadoEn        DateTime        @default(now()) @map("creado_en") @db.Timestamptz

  detalles SalidaDetalle[]

  @@unique([bancoId, id])
  @@map("salida")
  @@schema("inventario")
}

/// El movimiento de cada fila de una salida. Lote, cantidad y kilos se leen
/// del movimiento; el valor comercial, de su valoración. Sin UPDATE ni DELETE.
model SalidaDetalle {
  bancoId      String   @map("banco_id") @db.Uuid
  salidaId     String   @map("salida_id") @db.Uuid
  /// La posición de la fila en la salida, para devolverla en el mismo orden.
  orden        Int
  movimientoId String   @map("movimiento_id") @db.Uuid
  creadoPor    String   @map("creado_por") @db.VarChar(100)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz

  salida     Salida     @relation(fields: [bancoId, salidaId], references: [bancoId, id], onUpdate: Restrict)
  movimiento Movimiento @relation(fields: [bancoId, movimientoId], references: [bancoId, id], onUpdate: Restrict)

  @@id([bancoId, movimientoId])
  @@unique([salidaId, orden])
  @@map("salida_detalle")
  @@schema("inventario")
}

enum TipoInstitucion {
  parroquia
  comunidad_religiosa
  fundacion

  @@map("tipo_institucion")
  @@schema("beneficiarios")
}

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
  domingo

  @@map("dia_semana")
  @@schema("beneficiarios")
}

/// Catálogo por banco que administra coordinación. El índice único sobre
/// lower(nombre) va a mano en la migración (Prisma no expresa expresiones).
model TipoPoblacion {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId String  @map("banco_id") @db.Uuid
  nombre  String  @db.VarChar(100)
  activo  Boolean @default(true)

  instituciones Institucion[]
  beneficiarios Beneficiario[]

  @@unique([bancoId, id])
  @@map("tipo_poblacion")
  @@schema("beneficiarios")
}

/// Directorio de instituciones (SBA-26). El UNIQUE sobre lower(nombre) y el
/// CHECK de actualizado_por/actualizado_en van a mano en la migración.
model Institucion {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId          String          @map("banco_id") @db.Uuid
  nombre           String          @db.VarChar(200)
  tipo             TipoInstitucion
  contactoNombre   String          @map("contacto_nombre") @db.VarChar(200)
  contactoTelefono String?         @map("contacto_telefono") @db.VarChar(30)
  contactoCorreo   String?         @map("contacto_correo") @db.VarChar(200)
  direccion        String?         @db.VarChar(500)
  diaRecogida      DiaSemana?      @map("dia_recogida")
  tipoPoblacionId  String          @map("tipo_poblacion_id") @db.Uuid
  activa           Boolean         @default(true)
  actualizadoPor   String?         @map("actualizado_por") @db.VarChar(100)
  actualizadoEn    DateTime?       @map("actualizado_en") @db.Timestamptz

  tipoPoblacion TipoPoblacion      @relation(fields: [bancoId, tipoPoblacionId], references: [bancoId, id])
  membresias    Membresia[]
  alertas       AlertaDuplicidad[]

  @@unique([bancoId, id])
  @@index([bancoId, activa])
  @@map("institucion")
  @@schema("beneficiarios")
}

// --- Registro nominal (migración B, SBA-15) ---------------------------------
// Prisma no expresa los UNIQUE parciales, los CHECK ni las políticas: van a
// mano en 20261022040000_beneficiarios_registro_nominal.

enum TipoDocumento {
  cc
  ce
  ti
  pasaporte
  registro_civil
  pep
  ppt

  @@map("tipo_documento")
  @@schema("beneficiarios")
}

enum Sexo {
  masculino
  femenino
  prefiero_no_decirlo

  @@map("sexo")
  @@schema("beneficiarios")
}

enum Parentesco {
  madre
  padre
  padrastro_madrastra
  abuelo_a
  bisabuelo_a
  hermano_a
  hermanastro_a
  tio_a
  tio_abuelo_a
  primo_a
  cunado_a
  sobrino_a
  tutor_legal
  otro

  @@map("parentesco")
  @@schema("beneficiarios")
}

enum MotivoFinRepresentacion {
  mayoria_edad
  cambio_representante
  otro

  @@map("motivo_fin_representacion")
  @@schema("beneficiarios")
}

enum MotivoFinMembresia {
  se_mudo
  dejo_de_asistir
  fallecio
  traslado
  otro

  @@map("motivo_fin_membresia")
  @@schema("beneficiarios")
}

enum EstadoAlerta {
  abierta
  resuelta
  descartada

  @@map("estado_alerta")
  @@schema("beneficiarios")
}

/// Una fila por ser humano dentro de un banco (ADR-15, D1). El número va en
/// claro mientras los datos sean sintéticos; SBA-31 lo cambia por
/// documento_cifrado y documento_hmac antes del primer dato real.
model Persona {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId         String        @map("banco_id") @db.Uuid
  tipoDocumento   TipoDocumento @map("tipo_documento")
  numeroDocumento String        @map("numero_documento") @db.VarChar(20)
  nombres         String        @db.VarChar(100)
  apellidos       String        @db.VarChar(100)
  sexo            Sexo
  fechaNacimiento DateTime      @map("fecha_nacimiento") @db.Date
  telefono        String?       @db.VarChar(30)
  direccion       String?       @db.VarChar(500)

  beneficiario       Beneficiario?
  representaciones   Representacion[]
  consentimientos    Consentimiento[] @relation("titular")
  consentimientosPor Consentimiento[] @relation("otorgante")

  @@unique([bancoId, id])
  @@unique([bancoId, numeroDocumento])
  @@map("persona")
  @@schema("beneficiarios")
}

model Beneficiario {
  personaId       String @id @map("persona_id") @db.Uuid
  bancoId         String @map("banco_id") @db.Uuid
  tipoPoblacionId String @map("tipo_poblacion_id") @db.Uuid

  persona          Persona            @relation(fields: [bancoId, personaId], references: [bancoId, id])
  tipoPoblacion    TipoPoblacion      @relation(fields: [bancoId, tipoPoblacionId], references: [bancoId, id])
  representaciones Representacion[]
  membresias       Membresia[]
  alertas          AlertaDuplicidad[]

  @@unique([bancoId, personaId])
  @@map("beneficiario")
  @@schema("beneficiarios")
}

model Representacion {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId                String                   @map("banco_id") @db.Uuid
  beneficiarioId         String                   @map("beneficiario_id") @db.Uuid
  representantePersonaId String                   @map("representante_persona_id") @db.Uuid
  parentesco             Parentesco
  inicioEn               DateTime                 @default(now()) @map("inicio_en") @db.Timestamptz
  finEn                  DateTime?                @map("fin_en") @db.Timestamptz
  motivoFin              MotivoFinRepresentacion? @map("motivo_fin")

  beneficiario  Beneficiario @relation(fields: [bancoId, beneficiarioId], references: [bancoId, personaId])
  representante Persona      @relation(fields: [bancoId, representantePersonaId], references: [bancoId, id])

  @@map("representacion")
  @@schema("beneficiarios")
}

/// Append-only: sin UPDATE ni DELETE para la API (como el libro, ADR-08).
model Consentimiento {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId            String   @map("banco_id") @db.Uuid
  personaId          String   @map("persona_id") @db.Uuid
  otorgantePersonaId String?  @map("otorgante_persona_id") @db.Uuid
  recogidoPor        String   @map("recogido_por") @db.VarChar(100)
  otorgadoEn         DateTime @default(now()) @map("otorgado_en") @db.Timestamptz
  versionAviso       String   @map("version_aviso") @db.VarChar(20)
  finalidad          String
  soporteClave       String?  @map("soporte_clave") @db.VarChar(100)

  persona   Persona  @relation("titular", fields: [bancoId, personaId], references: [bancoId, id], onUpdate: Restrict)
  otorgante Persona? @relation("otorgante", fields: [bancoId, otorgantePersonaId], references: [bancoId, id], onUpdate: Restrict)

  @@index([bancoId, personaId, otorgadoEn(sort: Desc)])
  @@map("consentimiento")
  @@schema("beneficiarios")
}

/// Una sola activa (fin_en NULL) por beneficiario: UNIQUE parcial en la migración.
model Membresia {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String              @map("banco_id") @db.Uuid
  beneficiarioId String              @map("beneficiario_id") @db.Uuid
  institucionId  String              @map("institucion_id") @db.Uuid
  /// Lo pone la base: `@default(now())` lo calcularía Prisma con el reloj de la API.
  inicioEn       DateTime            @default(dbgenerated("now()")) @map("inicio_en") @db.Timestamptz
  finEn          DateTime?           @map("fin_en") @db.Timestamptz
  motivoFin      MotivoFinMembresia? @map("motivo_fin")
  creadoPor      String              @map("creado_por") @db.VarChar(100)
  cerradoPor     String?             @map("cerrado_por") @db.VarChar(100)

  beneficiario Beneficiario       @relation(fields: [bancoId, beneficiarioId], references: [bancoId, personaId], onUpdate: Restrict)
  institucion  Institucion        @relation(fields: [bancoId, institucionId], references: [bancoId, id], onUpdate: Restrict)
  alertas      AlertaDuplicidad[]

  @@unique([bancoId, id])
  @@index([institucionId, finEn])
  @@index([beneficiarioId, inicioEn(sort: Desc)])
  @@map("membresia")
  @@schema("beneficiarios")
}

model AlertaDuplicidad {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId                  String       @map("banco_id") @db.Uuid
  beneficiarioId           String       @map("beneficiario_id") @db.Uuid
  institucionSolicitanteId String       @map("institucion_solicitante_id") @db.Uuid
  membresiaVigenteId       String       @map("membresia_vigente_id") @db.Uuid
  estado                   EstadoAlerta @default(abierta)
  creadoEn                 DateTime     @default(now()) @map("creado_en") @db.Timestamptz
  creadoPor                String       @map("creado_por") @db.VarChar(100)

  beneficiario           Beneficiario @relation(fields: [bancoId, beneficiarioId], references: [bancoId, personaId])
  institucionSolicitante Institucion  @relation(fields: [bancoId, institucionSolicitanteId], references: [bancoId, id])
  membresiaVigente       Membresia    @relation(fields: [bancoId, membresiaVigenteId], references: [bancoId, id])

  @@index([bancoId, estado, creadoEn])
  @@map("alerta_duplicidad")
  @@schema("beneficiarios")
}

// Configuración de Prisma para SIGBA (ADR-05, ADR-07)
// Multi-schema: core, plataforma, inventario, beneficiarios, analitica

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "plataforma", "inventario", "beneficiarios", "analitica"]
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// Schema: plataforma
// ==========================================

model Red {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String   @db.VarChar(200)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  bancos Banco[]

  @@map("red")
  @@schema("plataforma")
}

model Banco {
  id            String   @id @default(uuid()) @db.Uuid
  redId         String   @map("red_id") @db.Uuid
  nombre        String   @db.VarChar(200)
  codigo        String   @unique @db.VarChar(20)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  red           Red              @relation(fields: [redId], references: [id])
  bodegas       Bodega[]
  parametros    ParametroBanco[]
  usuariosRoles UsuarioRol[]

  @@map("banco")
  @@schema("plataforma")
}

model Bodega {
  id            String   @id @default(uuid()) @db.Uuid
  bancoId       String   @map("banco_id") @db.Uuid
  /// Único por banco sin importar mayúsculas: índice sobre lower(nombre) en la migración.
  nombre        String   @db.VarChar(80)
  direccion     String?  @db.VarChar(200)
  activa        Boolean  @default(true)
  creadoPor     String?  @map("creado_por") @db.VarChar(100)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  banco Banco @relation(fields: [bancoId], references: [id])

  @@map("bodega")
  @@schema("plataforma")
}

model Usuario {
  id            String   @id @default(uuid()) @db.Uuid
  emisor        String   @db.VarChar(500)
  auth0Sub      String   @map("auth0_sub") @db.VarChar(200)
  email         String   @unique @db.VarChar(200)
  nombre        String   @db.VarChar(200)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  roles UsuarioRol[]

  @@unique([emisor, auth0Sub])
  @@map("usuario")
  @@schema("plataforma")
}

model Rol {
  id            String   @id @default(uuid()) @db.Uuid
  codigo        String   @unique @db.VarChar(50)
  nombre        String   @db.VarChar(100)
  descripcion   String?  @db.VarChar(500)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  usuarios UsuarioRol[]

  @@map("rol")
  @@schema("plataforma")
}

/// El alcance depende del rol: super_admin sin banco, institucion con banco e
/// institución, el resto con banco y sin institución. Lo exige el trigger
/// usuario_rol_alcance, y el UNIQUE es NULLS NOT DISTINCT (SBA-18); Prisma no
/// expresa ninguno de los dos.
model UsuarioRol {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  rolId         String   @map("rol_id") @db.Uuid
  bancoId       String?  @map("banco_id") @db.Uuid
  /// Sin FK (ADR-05): la institución es de beneficiarios. Que exista y sea del
  /// banco de la asignación lo tendrá que validar el servicio que asigne roles,
  /// que todavía no existe.
  institucionId String?  @map("institucion_id") @db.Uuid
  activo        Boolean  @default(true)
  creadoPor     String?  @map("creado_por") @db.VarChar(100)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])
  banco   Banco?  @relation(fields: [bancoId], references: [id])

  @@unique([usuarioId, rolId, bancoId, institucionId])
  @@map("usuario_rol")
  @@schema("plataforma")
}

model ParametroBanco {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId     String    @map("banco_id") @db.Uuid
  clave       String    @db.Text
  valor       Json      @db.JsonB
  version     Int
  fechaInicio DateTime  @map("fecha_inicio") @db.Date
  fechaFin    DateTime? @map("fecha_fin") @db.Date
  creadoPor   String?   @map("creado_por") @db.VarChar(100)
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  banco Banco @relation(fields: [bancoId], references: [id])

  @@unique([bancoId, clave, version])
  @@index([bancoId, clave, fechaInicio])
  @@map("parametro_banco")
  @@schema("plataforma")
}

// ==========================================
// Schema: inventario
// ==========================================

// Las FK dentro del banco son compuestas (banco_id, id). Una FK simple la
// comprueba Postgres sin RLS, así que dejaría colgar un producto del banco A
// de una categoría del banco B.

/// Un código del Banco (C801, G103), que agrupa productos en cualquier
/// presentación. La línea (Cereales, Grasas) agrupa códigos en pantalla.
model Categoria {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String   @map("banco_id") @db.Uuid
  /// Sin código, los productos de la categoría quedan pendientes de código.
  codigo         String?  @db.VarChar(20)
  nombre         String   @db.VarChar(100)
  linea          String?  @db.VarChar(100)
  /// Los productos que el Banco lista bajo el código, para orientar al operario.
  descripcion    String?  @db.Text
  activa         Boolean  @default(true)
  creadoPor      String?  @map("creado_por") @db.VarChar(100)
  actualizadoPor String?  @map("actualizado_por") @db.VarChar(100)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  productos Producto[]

  @@unique([bancoId, id])
  // El nombre se repite en la hoja del Banco (cuatro «Otros alimentos»); el
  // código no.
  @@unique([bancoId, codigo])
  @@map("categoria")
  @@schema("inventario")
}

model Producto {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String   @map("banco_id") @db.Uuid
  categoriaId    String   @map("categoria_id") @db.Uuid
  nombre         String   @db.VarChar(200)
  activo         Boolean  @default(true)
  creadoPor      String?  @map("creado_por") @db.VarChar(100)
  actualizadoPor String?  @map("actualizado_por") @db.VarChar(100)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  categoria   Categoria    @relation(fields: [bancoId, categoriaId], references: [bancoId, id])
  referencias Referencia[]

  @@unique([bancoId, id])
  // El UNIQUE (banco_id, inventario.normalizar(nombre)) vive en la migración
  // 20261013120000: Prisma no expresa índices sobre expresiones (SBA-22).
  @@map("producto")
  @@schema("inventario")
}

/// Producto más presentación, sin marca ni SKU: arroz Diana 500 g y arroz D1
/// 500 g son la misma referencia (Arquitectura, glosario). El código del Banco
/// lo hereda de la categoría de su producto.
model Referencia {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId            String   @map("banco_id") @db.Uuid
  productoId         String   @map("producto_id") @db.Uuid
  presentacion       String   @db.VarChar(100)
  equivalenciaKg     Decimal  @map("equivalencia_kg") @db.Decimal(10, 3)
  creadaDesdeCelular Boolean  @default(false) @map("creada_desde_celular")
  activa             Boolean  @default(true)
  creadoPor          String?  @map("creado_por") @db.VarChar(100)
  actualizadoPor     String?  @map("actualizado_por") @db.VarChar(100)
  creadoEn           DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn      DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  producto Producto @relation(fields: [bancoId, productoId], references: [bancoId, id])
  lotes    Lote[]
  precios  Precio[]

  @@unique([bancoId, id])
  // El UNIQUE (banco_id, producto_id, inventario.normalizar(presentacion)) vive
  // en la migración 20261013120000: Prisma no expresa índices sobre expresiones.
  @@map("referencia")
  @@schema("inventario")
}

enum TipoDonante {
  empresa
  parroquia
  particular
  otro_banco

  @@map("tipo_donante")
  @@schema("inventario")
}

model Donante {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String      @map("banco_id") @db.Uuid
  nombre         String      @db.VarChar(200)
  tipo           TipoDonante
  contacto       String?     @db.VarChar(200)
  activo         Boolean     @default(true)
  creadoPor      String?     @map("creado_por") @db.VarChar(100)
  actualizadoPor String?     @map("actualizado_por") @db.VarChar(100)
  creadoEn       DateTime    @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime    @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  recepciones Recepcion[]

  @@unique([bancoId, id])
  @@index([bancoId, tipo])
  @@map("donante")
  @@schema("inventario")
}

enum OrigenRecepcion {
  propia
  abaco
  plataforma

  @@map("origen_recepcion")
  @@schema("inventario")
}

enum NovedadRecepcion {
  roto
  reempacado
  no_apto

  @@map("novedad_recepcion")
  @@schema("inventario")
}

/// Sin precio vigente aprobado la fila queda pendiente: nunca en cero (ADR-13).
/// Pasa a con_precio cuando se aprueba un precio que cubre su fecha (SBA-43), y
/// no vuelve.
enum EstadoValoracion {
  pendiente
  con_precio

  @@map("estado_valoracion")
  @@schema("inventario")
}

/// El signo de la cantidad lo fija el tipo: entrada suma, salida y baja
/// restan, ajuste y traslado van en los dos sentidos (SBA-35).
enum TipoMovimiento {
  entrada
  salida
  traslado
  baja
  ajuste

  @@map("tipo_movimiento")
  @@schema("inventario")
}

/// Una donación recibida (SBA-24). La idempotencia por comando la lleva
/// `core.comando_procesado` (SBA-69). Un trigger la deja sin UPDATE ni DELETE.
model Recepcion {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId   String          @map("banco_id") @db.Uuid
  donanteId String          @map("donante_id") @db.Uuid
  origen    OrigenRecepcion
  /// Sin FK: bodega vive en plataforma y SBA-34 no cruza schemas.
  bodegaId  String          @map("bodega_id") @db.Uuid
  creadoPor String          @map("creado_por") @db.VarChar(100)
  creadoEn  DateTime        @default(now()) @map("creado_en") @db.Timestamptz

  donante  Donante            @relation(fields: [bancoId, donanteId], references: [bancoId, id], onUpdate: Restrict)
  lotes    Lote[]
  detalles RecepcionDetalle[]

  @@unique([bancoId, id])
  @@map("recepcion")
  @@schema("inventario")
}

/// Lo recibido de una referencia en una recepción, con su vencimiento. El saldo
/// se lleva por banco, bodega y lote (Arquitectura 8.3). Sin UPDATE ni DELETE.
model Lote {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String    @map("banco_id") @db.Uuid
  recepcionId    String    @map("recepcion_id") @db.Uuid
  referenciaId   String    @map("referencia_id") @db.Uuid
  /// El lote impreso en el empaque, si lo trae.
  codigo         String?   @db.VarChar(50)
  /// Nulo si el producto no trae fecha, como el aseo y los no alimentos.
  vencimiento    DateTime? @db.Date
  /// Kilos por unidad al recibir, congelados: el saldo y todo movimiento del
  /// lote pesan con esta y no con la que tenga hoy la referencia (SBA-35).
  equivalenciaKg Decimal   @map("equivalencia_kg") @db.Decimal(10, 3)
  creadoPor      String    @map("creado_por") @db.VarChar(100)
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  recepcion   Recepcion    @relation(fields: [bancoId, recepcionId], references: [bancoId, id], onUpdate: Restrict)
  referencia  Referencia   @relation(fields: [bancoId, referenciaId], references: [bancoId, id], onUpdate: Restrict)
  movimientos Movimiento[]
  saldos      Saldo[]

  // Para que el movimiento no nombre una referencia distinta a la del lote.
  @@unique([bancoId, id, referenciaId])
  @@map("lote")
  @@schema("inventario")
}

/// Lo que la recepción sabe de cada fila y el libro no. Referencia, lote,
/// cantidad y kilos se leen del movimiento. Solo `valoracion` cambia, de
/// pendiente a con_precio (SBA-43).
model RecepcionDetalle {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId        String            @map("banco_id") @db.Uuid
  recepcionId    String            @map("recepcion_id") @db.Uuid
  /// La posición de la fila en la recepción, para devolverla en el mismo orden.
  orden          Int
  /// El movimiento de entrada que la fila escribió en el libro.
  movimientoId   String            @map("movimiento_id") @db.Uuid
  novedad        NovedadRecepcion?
  valoracion     EstadoValoracion  @default(pendiente)
  creadoPor      String            @map("creado_por") @db.VarChar(100)
  actualizadoPor String            @map("actualizado_por") @db.VarChar(100)
  creadoEn       DateTime          @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime          @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  recepcion  Recepcion  @relation(fields: [bancoId, recepcionId], references: [bancoId, id], onUpdate: Restrict)
  movimiento Movimiento @relation(fields: [bancoId, movimientoId], references: [bancoId, id], onUpdate: Restrict)

  @@unique([bancoId, movimientoId])
  @@unique([recepcionId, orden])
  @@map("recepcion_detalle")
  @@schema("inventario")
}

/// Libro append-only (ADR-08): un trigger rechaza UPDATE, DELETE y TRUNCATE,
/// y por eso no lleva actualizado_en. El id lo genera el celular, uno por
/// detalle; la llave lleva banco_id para que un id de otro banco no choque.
/// `comando_id` es el del comando que lo escribió. No sabe de recepciones: es
/// el detalle el que apunta a su movimiento, y así salidas y traslados usarán
/// el mismo libro.
model Movimiento {
  id           String         @db.Uuid
  bancoId      String         @map("banco_id") @db.Uuid
  comandoId    String         @map("comando_id") @db.Uuid
  tipo         TipoMovimiento
  referenciaId String         @map("referencia_id") @db.Uuid
  loteId       String         @map("lote_id") @db.Uuid
  bodegaId     String         @map("bodega_id") @db.Uuid
  /// Con signo: positiva suma al saldo, negativa resta.
  cantidad     Decimal        @db.Decimal(10, 3)
  kilos        Decimal        @db.Decimal(20, 6)
  creadoPor    String         @map("creado_por") @db.VarChar(100)
  creadoEn     DateTime       @default(now()) @map("creado_en") @db.Timestamptz

  lote       Lote              @relation(fields: [bancoId, loteId, referenciaId], references: [bancoId, id, referenciaId], onUpdate: Restrict)
  detalle    RecepcionDetalle?
  valoracion Valoracion?
  baja       Baja?
  ajuste     Ajuste?

  @@id([bancoId, id])
  @@index([bancoId, comandoId])
  @@map("movimiento")
  @@schema("inventario")
}

/// Lo que hay de un lote en una bodega: la suma de sus movimientos. Solo lo
/// escribe el trigger `movimiento_suma_al_saldo`; sigba_app lo lee (SBA-35).
model Saldo {
  bancoId       String   @map("banco_id") @db.Uuid
  bodegaId      String   @map("bodega_id") @db.Uuid
  loteId        String   @map("lote_id") @db.Uuid
  referenciaId  String   @map("referencia_id") @db.Uuid
  cantidad      Decimal  @db.Decimal(14, 3)
  kilos         Decimal  @db.Decimal(24, 6)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz

  lote Lote @relation(fields: [bancoId, loteId, referenciaId], references: [bancoId, id, referenciaId], onUpdate: Restrict)

  @@id([bancoId, bodegaId, loteId])
  @@index([bancoId, referenciaId])
  @@map("saldo")
  @@schema("inventario")
}

enum FuentePrecio {
  remision
  sipsa
  catalogo
  manual

  @@map("fuente_precio")
  @@schema("inventario")
}

/// «Vencido» no se guarda: es un aprobado cuyo vigente_hasta ya pasó.
enum EstadoPrecio {
  propuesto
  aprobado

  @@map("estado_precio")
  @@schema("inventario")
}

/// Precio por referencia genérica, en pesos por unidad de la presentación
/// (SBA-39, ADR-13). Un trigger solo deja aprobar un propuesto o acortar la
/// vigencia de un aprobado; sin DELETE. La exclusión que impide que dos
/// aprobados de la misma referencia crucen vigencias vive en la migración
/// 20261015130000: Prisma no expresa EXCLUDE.
model Precio {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId            String       @map("banco_id") @db.Uuid
  referenciaId       String       @map("referencia_id") @db.Uuid
  valor              Decimal      @db.Decimal(14, 2)
  piso               Decimal      @db.Decimal(14, 2)
  techo              Decimal      @db.Decimal(14, 2)
  fuente             FuentePrecio
  evidencia          String
  vigenteDesde       DateTime     @map("vigente_desde") @db.Date
  vigenteHasta       DateTime?    @map("vigente_hasta") @db.Date
  estado             EstadoPrecio @default(propuesto)
  motivoFueraDeBanda String?      @map("motivo_fuera_de_banda")
  aprobadoPor        String?      @map("aprobado_por") @db.VarChar(100)
  aprobadoEn         DateTime?    @map("aprobado_en") @db.Timestamptz
  creadoPor          String       @map("creado_por") @db.VarChar(100)
  actualizadoPor     String       @map("actualizado_por") @db.VarChar(100)
  creadoEn           DateTime     @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn      DateTime     @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  referencia   Referencia   @relation(fields: [bancoId, referenciaId], references: [bancoId, id], onUpdate: Restrict)
  valoraciones Valoracion[]

  @@unique([bancoId, id])
  @@index([bancoId, referenciaId, vigenteDesde])
  @@map("precio")
  @@schema("inventario")
}

/// Lo que vale un movimiento que entró sin precio, escrito cuando se aprueba el
/// precio que cubre su fecha (SBA-43, ADR-13). Fila aparte para que el
/// movimiento no cambie; append-only como el libro y una sola por movimiento.
/// `importe` es cantidad × `valorUnitario`, exacto.
model Valoracion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId       String   @map("banco_id") @db.Uuid
  movimientoId  String   @map("movimiento_id") @db.Uuid
  precioId      String   @map("precio_id") @db.Uuid
  valorUnitario Decimal  @map("valor_unitario") @db.Decimal(14, 2)
  importe       Decimal  @db.Decimal(24, 5)
  creadoPor     String   @map("creado_por") @db.VarChar(100)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz

  movimiento Movimiento @relation(fields: [bancoId, movimientoId], references: [bancoId, id], onUpdate: Restrict)
  precio     Precio     @relation(fields: [bancoId, precioId], references: [bancoId, id], onUpdate: Restrict)

  @@unique([bancoId, movimientoId])
  @@index([bancoId, precioId])
  @@map("valoracion")
  @@schema("inventario")
}

enum MotivoBaja {
  vencido
  no_apto
  roto
  perdida

  @@map("motivo_baja")
  @@schema("inventario")
}

/// El motivo de una baja (SBA-42). Cantidad, lote y bodega se leen de su
/// movimiento. Un trigger la deja sin UPDATE ni DELETE (ADR-08).
model Baja {
  bancoId      String     @map("banco_id") @db.Uuid
  movimientoId String     @map("movimiento_id") @db.Uuid
  motivo       MotivoBaja
  creadoPor    String     @map("creado_por") @db.VarChar(100)
  creadoEn     DateTime   @default(now()) @map("creado_en") @db.Timestamptz

  movimiento Movimiento @relation(fields: [bancoId, movimientoId], references: [bancoId, id], onUpdate: Restrict)

  @@id([bancoId, movimientoId])
  @@map("baja")
  @@schema("inventario")
}

/// El motivo de un ajuste de conteo (SBA-42), texto libre obligatorio. Un
/// trigger lo deja sin UPDATE ni DELETE (ADR-08).
model Ajuste {
  bancoId      String   @map("banco_id") @db.Uuid
  movimientoId String   @map("movimiento_id") @db.Uuid
  motivo       String   @db.VarChar(500)
  creadoPor    String   @map("creado_por") @db.VarChar(100)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz

  movimiento Movimiento @relation(fields: [bancoId, movimientoId], references: [bancoId, id], onUpdate: Restrict)

  @@id([bancoId, movimientoId])
  @@map("ajuste")
  @@schema("inventario")
}

enum TipoInstitucion {
  parroquia
  comunidad_religiosa
  fundacion

  @@map("tipo_institucion")
  @@schema("beneficiarios")
}

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
  domingo

  @@map("dia_semana")
  @@schema("beneficiarios")
}

/// Catálogo por banco que administra coordinación. El índice único sobre
/// lower(nombre) va a mano en la migración (Prisma no expresa expresiones).
model TipoPoblacion {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId String  @map("banco_id") @db.Uuid
  nombre  String  @db.VarChar(100)
  activo  Boolean @default(true)

  instituciones Institucion[]

  @@unique([bancoId, id])
  @@map("tipo_poblacion")
  @@schema("beneficiarios")
}

/// Directorio de instituciones (SBA-26). El UNIQUE sobre lower(nombre) y el
/// CHECK de actualizado_por/actualizado_en van a mano en la migración.
model Institucion {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bancoId          String          @map("banco_id") @db.Uuid
  nombre           String          @db.VarChar(200)
  tipo             TipoInstitucion
  contactoNombre   String          @map("contacto_nombre") @db.VarChar(200)
  contactoTelefono String?         @map("contacto_telefono") @db.VarChar(30)
  contactoCorreo   String?         @map("contacto_correo") @db.VarChar(200)
  direccion        String?         @db.VarChar(500)
  diaRecogida      DiaSemana?      @map("dia_recogida")
  tipoPoblacionId  String          @map("tipo_poblacion_id") @db.Uuid
  activa           Boolean         @default(true)
  actualizadoPor   String?         @map("actualizado_por") @db.VarChar(100)
  actualizadoEn    DateTime?       @map("actualizado_en") @db.Timestamptz

  tipoPoblacion TipoPoblacion @relation(fields: [bancoId, tipoPoblacionId], references: [bancoId, id])

  @@unique([bancoId, id])
  @@index([bancoId, activa])
  @@map("institucion")
  @@schema("beneficiarios")
}

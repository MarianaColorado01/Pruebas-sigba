# Copia este archivo a .env y ajusta lo que necesites.
# .env está en .gitignore: los secretos viven en los servicios, no en Git
# (Arquitectura 5.3).

# --- API ---
PORT=3000
# DATABASE_URL se reserva para migraciones, seed y tareas administrativas.
DATABASE_URL=postgresql://sigba:sigba@localhost:5432/sigba?schema=public
API_DATABASE_URL=postgresql://sigba_app:sigba_app_local@localhost:5432/sigba?schema=public
CORS_ORIGINS=http://localhost:5173
# Origen de la PWA. Con él la API arma los enlaces de invitación (SBA-19, D4).
WEB_URL=http://localhost:5173

# --- Correo (SBA-19, D1) ---
# Opcional. Sin las dos variables no sale correo: la PWA muestra el enlace de
# invitación para copiarlo o compartirlo. Sirve cualquier SMTP (Resend, Brevo,
# cuenta institucional), p. ej. smtps://usuario:clave@smtp.proveedor.com:465
SMTP_URL=
CORREO_REMITENTE=

# --- PWA ---
VITE_API_URL=http://localhost:3000/api/v1

# --- Auth0 API (SBA-8) ---
AUTH0_ISSUER_URL=https://tenant-institucional.us.auth0.com/
AUTH0_AUDIENCE=https://api.sigba.example

# --- Auth0 PWA (SBA-8) ---
VITE_AUTH0_DOMAIN=tenant-institucional.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.sigba.example

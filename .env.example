# Copia este archivo a .env y ajusta lo que necesites.
# .env está en .gitignore: los secretos viven en los servicios, no en Git
# (Arquitectura 5.3).

# --- API ---
PORT=3000
DATABASE_URL="postgresql://usuario:password@host_de_neon/nombre_bd?sslmode=require"



# --- PWA ---
VITE_API_URL=http://localhost:3000/api/v1

# --- Auth0 (SBA-8) ---
# AUTH0_ISSUER_URL=https://<tenant>.auth0.com/
# AUTH0_AUDIENCE=https://api.sigba.local
# VITE_AUTH0_DOMAIN=<tenant>.auth0.com
# VITE_AUTH0_CLIENT_ID=<client-id>
# VITE_AUTH0_AUDIENCE=https://api.sigba.local

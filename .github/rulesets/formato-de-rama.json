{
  "name": "formato de rama",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": ["refs/heads/main", "refs/heads/revert-*"]
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "Rama generada por Linear: sba-<número>-<título>",
        "operator": "regex",
        "pattern": "^sba-[0-9]+-[a-z0-9-]+$",
        "negate": false
      }
    }
  ]
}

{
  "name": "sigba",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema Integrado de Gestión para Bancos de Alimentos",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "lint": "pnpm -r --no-bail run lint",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "pnpm -r --no-bail run test",
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "nuevo-modulo": "node scripts/nuevo-modulo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}

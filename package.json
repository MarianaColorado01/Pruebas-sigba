{
  "name": "sigba",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema Integrado de Gestión para Bancos de Alimentos",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "lint": "eslint . --max-warnings 0 && pnpm -r --no-bail run lint",
    "typecheck": "pnpm run build:packages && pnpm -r --no-bail run typecheck",
    "test": "pnpm run build:packages && pnpm -r --no-bail run test",
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "nuevo-modulo": "node scripts/nuevo-modulo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@sigba/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
